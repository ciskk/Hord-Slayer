{
  "name": "hord-slayer",
  "productName": "Hord Slayer",
  "version": "0.1.0",
  "description": "Hord Slayer — jogo de sobrevivência para Windows",
  "author": "Hord Slayer",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "prepare:game": "node scripts/prepare-game.cjs",
    "start": "npm run prepare:game && node scripts/start.cjs",
    "package": "npm run prepare:game && electron-forge package --platform=win32 --arch=x64",
    "make": "npm run prepare:game && electron-forge make --platform=win32 --arch=x64",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "npm run prepare:game && node tests/smoke.cjs",
    "test:soak": "npm run prepare:game && node tests/soak.cjs"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cinzel-decorative": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "playwright": "1.63.0"
  }
}
