{
  "name": "hord-slayer",
  "version": "1.0.0",
  "description": "Hord Slayer - Grim Cyber-Gothic Survival Game",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs && node scripts/validate-i18n.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "lint:i18n": "node scripts/validate-i18n.mjs",
    "scan:i18n": "node scripts/scan-unlocalized.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "serve:performance": "node scripts/serve-performance.mjs",
    "analyze:apk": "node scripts/analyze-apk-performance.mjs",
    "build:pc": "node scripts/build-desktop.mjs",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "keywords": [
    "game",
    "roguelike",
    "i18n",
    "canvas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-packager": "^17.1.2"
  }
}
